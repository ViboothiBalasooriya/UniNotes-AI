rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Academic Materials Bucket ──────────────────────────────────────────────
    match /academic_materials/{allPaths=**} {

      // Any authenticated user can read (stream) PDFs
      allow read: if request.auth != null;

      // Authenticated users can upload PDFs with the following constraints:
      // 1. Maximum size: 20MB (20 * 1024 * 1024 bytes)
      // 2. Content type must be PDF
      allow write: if request.auth != null
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';

      // Only admins can delete files
      // Note: Admin deletion is handled server-side via Firebase Admin SDK
      // Direct client-side delete is blocked for non-admins
    }
  }
}
